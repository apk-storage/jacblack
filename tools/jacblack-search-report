#!/usr/bin/env python3
"""Раздел утреннего отчёта: что люди искали за сутки и нашли ли.

Зачем. Отчёт по обходам отвечал на вопрос «наполняется ли база», и только на
него. Сергей, 09.10.2026: «а ты логи вообще ведешь? что ищут люди, что
находят, есть ли ошибки?» Логи велись — в них есть и размер ответа, и время,
и страна, — но никто в них не смотрел, и пустая выдача могла жить месяцами.
Именно так четыре раздачи RuDub по «Кэрри» простояли на 63-66 местах из 66:
прибор был зелёный, а человек ничего не находил.

Пустая выдача видна по РАЗМЕРУ ответа: `{"Results":[],"jacred":true}` — это
28 байт, а любая находка весит сотни. Поэтому порог стоит низко и в байтах,
а не в разборе тела: тела у нас в логах нет и быть не должно.

Разделяем два пути, иначе числа лгут. `title=` — поиск по карточке, его
делает Лампа сама, и там пусто означает «в базе этого фильма нет».
`query=`/`search=` — человек набрал руками, и пусто означает скорее
«не нашлось по такому написанию».

Запуск: jacblack-search-report [часов]   (по умолчанию 24)
"""
import collections
import datetime
import glob
import gzip
import re
import sys
import urllib.parse

ЛОГИ = "/var/log/nginx/jac.black.log"
# Пустой ответ. `{"Results":[],"jacred":true}` = 28 байт, пустой массив v1.0
# `[]` = 2 байта. Шестьдесят с запасом — но заметно меньше любой находки.
ПУСТО_БАЙТ = 60
# Медленный ответ. Четыре секунды — предел, после которого Лампа на ТВ уже
# показывает пустой экран, не дождавшись.
МЕДЛЕННО_С = 4.0

СТРОКА = re.compile(
    r'^(?P<ip>\S+) host="(?P<host>[^"]*)" \[(?P<when>[^\]]+)\] '
    r'"(?P<req>[^"]*)" (?P<code>\d{3}) (?P<bytes>\d+) '
    r'"(?P<ref>[^"]*)" "(?P<ua>[^"]*)".*?rt=(?P<rt>[\d.]+)')

ПОИСК = re.compile(r"/api/v[12]\.0/")


def строки(часов):
    """Строки лога за последние N часов, включая вчерашний файл после ротации."""
    порог = datetime.datetime.now().astimezone() - datetime.timedelta(hours=часов)

    файлы = [ЛОГИ] + sorted(glob.glob(ЛОГИ + ".1")) \
        + sorted(glob.glob(ЛОГИ + ".2.gz"))
    for путь in файлы:
        открыть = gzip.open if путь.endswith(".gz") else open
        try:
            with открыть(путь, "rt", encoding="utf-8", errors="replace") as ф:
                for строка in ф:
                    м = СТРОКА.match(строка)
                    if not м:
                        continue
                    try:
                        когда = datetime.datetime.strptime(
                            м.group("when"), "%d/%b/%Y:%H:%M:%S %z")
                    except ValueError:
                        continue
                    if когда >= порог:
                        yield м
        except OSError:
            continue


def название(запрос):
    """Что именно искали: из `title`, иначе из `query`/`search`."""
    части = urllib.parse.urlparse(запрос)
    поля = urllib.parse.parse_qs(части.query)
    for имя in ("title", "query", "Query", "search"):
        значение = (поля.get(имя) or [""])[0].strip()
        if значение:
            return значение
    return ""


# Наши собственные клиенты: их здоровье смотрим отдельной строкой.
#
# Повод (10.10.2026). jac.black из коробки стоит в нашем APK LampaBWA, но
# запросы парсера он делает из ВЕБВЬЮ — то есть приходит обычным Chrome на
# Android, и в общей куче его не отличить ни от браузера, ни от чужой
# сборки. Если у его пользователей посыплются пустые выдачи или отказы, в
# отчёте это ничем себя не выдаст.
#
# Отличает его только хвост в имени клиента, который ставит сам APK.
# `LampaApk` — как было, `LampaBWA` — как стало после переименования
# 11.10.2026 (решение Сергея); считаем оба, чтобы дни перехода не потерялись.
НАШИ_КЛИЕНТЫ = (("LampaBWA", "lampabwa"), ("LampaApk", "lampaapk"))


def наш_клиент(ua):
    низ = (ua or "").lower()
    for имя, метка in НАШИ_КЛИЕНТЫ:
        if метка in низ:
            return имя
    return None


def есть(поля, имя):
    return bool((поля.get(имя) or [""])[0].strip())


def путь_запроса(запрос):
    """Кто спрашивал: Лампа по карточке или человек руками."""
    поля = urllib.parse.parse_qs(urllib.parse.urlparse(запрос).query)
    if есть(поля, "title"):
        return "карточка"
    if есть(поля, "query") or есть(поля, "Query") or есть(поля, "search"):
        return "руками"
    return "иначе"


def главное():
    часов = int(sys.argv[1]) if len(sys.argv) > 1 else 24

    всего = пусто = медленно = ошибок = отсечено = 0
    пустые_названия = collections.Counter()
    пусто_по_пути = collections.Counter()
    отсечённые_адреса = collections.Counter()
    свои = collections.defaultdict(lambda: collections.Counter())

    for м in строки(часов):
        запрос = м.group("req").split(" ")[1] if " " in м.group("req") else ""
        if not ПОИСК.search(запрос):
            continue

        код = int(м.group("code"))
        всего += 1

        # Наши собственные клиенты считаем отдельно — иначе их здоровье
        # тонет в общем потоке. У LampaBWA User-Agent вебвью, то есть
        # обычный Chrome на Android, и отличает её только хвост в имени.
        свой = наш_клиент(м.group("ua"))
        if свой:
            свои[свой]["всего"] += 1

        if код >= 500:
            ошибок += 1
            if свой:
                свои[свой]["ошибок"] += 1
            continue
        if код in (403, 429):
            отсечено += 1
            отсечённые_адреса[м.group("ip")] += 1
            if свой:
                свои[свой]["отсечено"] += 1
            continue
        if код != 200:
            continue

        if float(м.group("rt")) >= МЕДЛЕННО_С:
            медленно += 1

        if int(м.group("bytes")) < ПУСТО_БАЙТ:
            пусто += 1
            имя = название(запрос)
            if имя:
                пустые_названия[имя] += 1
            пусто_по_пути[путь_запроса(запрос)] += 1
            if свой:
                свои[свой]["пусто"] += 1

    print("Поиск за %d ч" % часов)
    print()
    if not всего:
        print("ни одного запроса поиска — это само по себе повод проверить")
        return

    отдано = всего - ошибок - отсечено
    print("запросов %d: с находками %d, пусто %d (%.1f%%)"
          % (всего, max(отдано - пусто, 0), пусто,
             100.0 * пусто / отдано if отдано else 0.0))
    print("ошибок 5xx %d, дольше %.0f с — %d" % (ошибок, МЕДЛЕННО_С, медленно))

    # Отсечённых показываем С ВИНОВНИКОМ, иначе число пугает без смысла:
    # 09.10.2026 заслоны отказали 38 444 запросам, и 38 126 из них — один
    # перебиральщик каталога 144.31.4.206, отсечённый по решению Сергея
    # 15.09.2026. Живых людей среди них не было. Без разбивки такая строка
    # читается как «мы режем три четверти посетителей».
    if отсечено:
        главный = отсечённые_адреса.most_common(1)[0]
        остальные = отсечено - главный[1]
        print("отсечено заслонами %d: %s — %d, прочие — %d"
              % (отсечено, главный[0], главный[1], остальные))

    if пусто_по_пути:
        разбивка = ", ".join("%s %d" % (к, в) for к, в in пусто_по_пути.most_common())
        print("пусто по пути: %s" % разбивка)

    if пустые_названия:
        print()
        print("чаще всего не находили:")
        for имя, сколько in пустые_названия.most_common(7):
            print("  %2d × %s" % (сколько, имя[:58]))

    # Наши клиенты — отдельной строкой. Молчим, когда их нет: пустой раздел
    # в суточном письме только занимает место.
    if свои:
        print()
        print("наши клиенты:")
        for имя, с in sorted(свои.items()):
            отдано = с["всего"] - с["ошибок"] - с["отсечено"]
            хвост = ""
            if с["отсечено"]:
                хвост += ", ОТСЕЧЕНО %d" % с["отсечено"]
            if с["ошибок"]:
                хвост += ", ошибок %d" % с["ошибок"]
            print("  %-10s запросов %d: с находками %d, пусто %d%s"
                  % (имя, с["всего"], max(отдано - с["пусто"], 0),
                     с["пусто"], хвост))


if __name__ == "__main__":
    главное()
